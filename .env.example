# Copy this file to .env and fill in your keys. Never commit .env.
FAL_KEY=your_fal_key_here            # required: all generation (fal.ai)
KIE_API_KEY=your_kie_key_here        # required for uploads of local images (kie.ai)
WAVESPEED_API_KEY=                   # optional: second fallback provider (wavespeed.ai)
